# Config de build para el deploy de Vercel. No hay secretos acá: en CRA todo lo que empieza
# con REACT_APP_ se inlinea en el bundle que baja el navegador.
REACT_APP_API_URL=https://overtime-ddyl.onrender.com/api

# PENDIENTE (bug preexistente, no rompe el build): sin esta variable, REACT_APP_PUBLIC_URL cae
# al valor de .env —http://localhost:3000— también en producción, así que los links de
# invitación a jugadores que genera armarLinkInvitacion() apuntan a localhost y no le sirven a
# nadie. Completá acá el dominio real de Overtime-Public y descomentá:
# REACT_APP_PUBLIC_URL=https://<dominio-de-overtime-public>
