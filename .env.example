# Copiá este archivo a .env.development / .env.production y completá los valores.

# Puerto del dev server y si abre el navegador solo.
PORT=3003
BROWSER=none

# API del backend. En dev apunta al backend local; en producción, a Render.
REACT_APP_API_URL=http://localhost:5000/api

# Portal público: hospeda /claim/:token, el canje de invitaciones a jugadores.
REACT_APP_PUBLIC_URL=http://localhost:3000
