# Copiá este archivo a .env.development / .env.production y completá los valores.

# Puerto del dev server y si abre el navegador solo.
PORT=3003
BROWSER=none

# API del backend. En dev apunta al backend local; en producción, a Render.
REACT_APP_API_URL=http://localhost:5000/api

# Portal público: hospeda /claim/:token, el canje de invitaciones a jugadores.
REACT_APP_PUBLIC_URL=http://localhost:3000

# Reporte de errores. Sin esto, el SDK ni se inicializa: dejarlo vacío en desarrollo.
# El DSN de Sentry es público por diseño (viaja en el bundle), no es un secreto.
REACT_APP_SENTRY_DSN=

# Overtime-Manager: hospeda /claim/:token, el canje de invitaciones a jugadores.
# Antes esto apuntaba a Public (REACT_APP_PUBLIC_URL), donde el jugador creaba su cuenta y
# quedaba en la app de los hinchas en vez de en la suya.
REACT_APP_MANAGER_URL=http://localhost:3001
